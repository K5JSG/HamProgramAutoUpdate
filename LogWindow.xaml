<Window x:Class="HamProgramAutoUpdate.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log" Height="640" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        Icon="Resources/app.ico">

    <DockPanel Margin="16">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold"
                       Foreground="White" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Open Folder" Style="{StaticResource SmallSecondary}"
                        Click="OpenFolder_Click" Margin="0,0,8,0" />
                <Button Content="Reload" Style="{StaticResource SmallSecondary}"
                        Click="Reload_Click" Margin="0,0,8,0" />
                <Button Content="Close" Style="{StaticResource SmallPrimary}"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="PathText" DockPanel.Dock="Top"
                   FontSize="11" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,10" />

        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1" CornerRadius="8">
            <ScrollViewer x:Name="Scroller" Margin="12"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="LogText" IsReadOnly="True"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextBrush}"
                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Disabled"
                         HorizontalScrollBarVisibility="Disabled" />
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
