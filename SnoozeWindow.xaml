<Window x:Class="HamProgramAutoUpdate.SnoozeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snooze updates" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        Icon="Resources/app.ico">

    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold"
                   Foreground="White" TextWrapping="Wrap" Margin="0,0,0,6" />
        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                   Margin="0,0,0,16"
                   Text="Updates for this program are skipped until the date and time below, then resume on their own. Other programs are not affected." />

        <TextBlock Text="SNOOZE UNTIL" Style="{StaticResource LabelText}" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <DatePicker x:Name="DateBox" Width="130" Margin="0,0,10,0"
                        SelectedDateChanged="Input_Changed" />
            <ComboBox x:Name="HourBox" Width="56" Margin="0,0,4,0"
                      SelectionChanged="Input_Changed" />
            <TextBlock Text=":" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox x:Name="MinuteBox" Width="56" Margin="0,0,8,0"
                      SelectionChanged="Input_Changed" />
            <ComboBox x:Name="AmPmBox" Width="60" SelectionChanged="Input_Changed" />
        </StackPanel>

        <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,18" MinHeight="32" />

        <Grid>
            <Button x:Name="ClearButton" Content="Clear snooze"
                    Style="{StaticResource SmallDanger}" HorizontalAlignment="Left"
                    Click="Clear_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SmallSecondary}"
                        IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="SnoozeButton" Content="Snooze"
                        Style="{StaticResource SmallPrimary}" IsDefault="True"
                        Click="Snooze_Click" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
