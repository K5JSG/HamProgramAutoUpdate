<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms is enabled only for NotifyIcon, which WPF has no equivalent
         of. This avoids taking a NuGet dependency just for the tray icon. -->
    <UseWindowsForms>true</UseWindowsForms>

    <AssemblyName>HamProgramAutoUpdate</AssemblyName>
    <RootNamespace>HamProgramAutoUpdate</RootNamespace>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Set here rather than in app.manifest, which trips warning WFAC010
         when WinForms is enabled. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Company>K5JSG</Company>
    <Product>Ham Program Auto Update</Product>
    <Description>Monitors and runs the ham radio program update scripts.</Description>
    <Copyright>Copyright Â© K5JSG</Copyright>
  </PropertyGroup>

  <!-- Publish profile: a single self-contained exe with no .NET runtime
       required on the target PC. Invoked by build.ps1 and the CI workflow. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Trimming is deliberately OFF: WPF is not trim-safe and silently
         breaks XAML resource lookups at runtime. -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="ClaudeArchive\" />
  </ItemGroup>

	<ItemGroup>
		<!-- Now configures files to copy into your bin folder layout dynamically -->
		<None Include="ClaudeArchive\Extracted_Dashboard_History\**\*.json">
			<Generator>None</Generator>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="ClaudeArchive\pull_dashboard.ps1" />
		<None Include="ClaudeArchive\auto_pull.bat" />
	</ItemGroup>

  <ItemGroup>
    <!-- CHIRP is the one program whose updater still runs as a bundled
         Python exe rather than an in-process C# implementation - see
         Services/Updaters/Programs/ChirpUpdater.cs for why (archive.chirpmyradio.com
         sits behind a Cloudflare challenge that a real C# browser-automation
         port could not reliably clear; see the class doc comment for the
         two independent, non-coordinate-tuning-fixable blockers found).
         Shipped as a sibling file next to HamProgramAutoUpdate.exe, the same
         way the ClaudeArchive files above are, so it travels with this
         app's own install rather than depending on a separate folder the
         user maintains independently. -->
    <!-- ExcludeFromSingleFile: without this, PublishSingleFile bundles
         content items INTO the single exe and extracts them to a temp
         cache at runtime instead of leaving them on disk next to it,
         which breaks the sibling-file path ChirpUpdater.cs looks for
         (and the installer's own file copy). This keeps it a real,
         separate file next to HamProgramAutoUpdate.exe in every build. -->
    <None Include="ChirpUpdaterBinary\Chirp Update Script.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>


</Project>
