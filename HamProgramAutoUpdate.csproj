<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms is enabled only for NotifyIcon, which WPF has no equivalent
         of. This avoids taking a NuGet dependency just for the tray icon. -->
    <UseWindowsForms>true</UseWindowsForms>

    <AssemblyName>HamProgramAutoUpdate</AssemblyName>
    <RootNamespace>HamProgramAutoUpdate</RootNamespace>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Set here rather than in app.manifest, which trips warning WFAC010
         when WinForms is enabled. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <Version>1.3.1</Version>
    <FileVersion>1.3.1.0</FileVersion>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>
    <Company>K5JSG</Company>
    <Product>Ham Program Auto Update</Product>
    <Description>Checks a fixed set of ham radio programs for updates and installs them silently.</Description>
    <Copyright>Copyright © 2026 K5JSG - Jeremy Gaynor</Copyright>
  </PropertyGroup>

  <!-- Publish profile: a single self-contained exe with no .NET runtime
       required on the target PC. Invoked by build.ps1 and the CI workflow. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Trimming is deliberately OFF: WPF is not trim-safe and silently
         breaks XAML resource lookups at runtime. -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests/ holds its own separate test project (see the .slnx) - without
         this, this project's default recursive file glob would also try to
         compile its source (and generated obj/ files) into itself, the same
         issue the sibling POTA project solves for its own Tools/ folder. -->
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- CHIRP's updater runs in-process now (Services/Updaters/Programs/Chirp/
         ChirpCloudflareAutomation.cs - a native port of the old bundled Python
         exe's technique; see ChirpUpdater.cs's class doc comment). The only
         thing it still needs from disk is the learned Cloudflare Turnstile
         checkbox position, read from its own folder (ChirpUpdaterBinary\,
         next to HamProgramAutoUpdate.exe) at runtime.
         Sourced from ChirpUpdaterSource\ (where it's version-controlled,
         alongside the old Python implementation kept there as a fallback -
         see that folder's README.txt) rather than ChirpUpdaterBinary\ itself,
         which is entirely gitignored as a build/runtime-only folder.
         ExcludeFromSingleFile: without this, PublishSingleFile bundles
         content items INTO the single exe and extracts them to a temp cache
         at runtime instead of leaving them on disk next to it, which breaks
         the sibling-file path ChirpCloudflareAutomation looks for (and the
         installer's own file copy). -->
    <None Include="ChirpUpdaterSource\captcha_coords.json">
      <Link>ChirpUpdaterBinary\captcha_coords.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>


</Project>
