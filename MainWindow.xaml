<Window x:Class="HamProgramAutoUpdate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ham Program Auto Update"
        Height="820" Width="1250"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Icon="Resources/app.ico">

    <DockPanel Margin="20">

        <!-- ============================================ header ========== -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Ham Program Auto Update"
                       FontSize="24" FontWeight="Bold"
                       Foreground="White" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UpdateAvailableButton" Visibility="Collapsed"
                        Style="{StaticResource PrimaryButton}"
                        Click="UpdateAvailable_Click" Margin="0,0,12,0" />

                <Border x:Name="ElevationBadge"
                        CornerRadius="10" Padding="9,3" Margin="0,0,12,0"
                        Background="#26FFC300" VerticalAlignment="Center">
                    <TextBlock x:Name="ElevationText" Text="NOT ADMIN"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource WarnBrush}" />
                </Border>

                <TextBlock x:Name="LastUpdatedText" Text="Loading..."
                           FontSize="12" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,14,0" />

                <Button x:Name="RunAllButton" Content="Run Updates Now"
                        Style="{StaticResource PrimaryButton}"
                        Click="RunAll_Click" Margin="0,0,8,0" />

                <Button Content="Clear Logs" Style="{StaticResource DangerButton}"
                        Click="ClearAll_Click" Margin="0,0,8,0" />

                <Button Content="Refresh" Style="{StaticResource SecondaryButton}"
                        Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <!-- ============================================ cards =========== -->
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="CardList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="370" Margin="0,0,16,16" Padding="18"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush2}"
                                    BorderThickness="1" CornerRadius="10">
                                <StackPanel>

                                    <!-- title + status badge -->
                                    <Grid Margin="0,0,0,14">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="17" FontWeight="Bold"
                                                   Foreground="White" VerticalAlignment="Center" />
                                        <Border CornerRadius="10" Padding="9,3"
                                                HorizontalAlignment="Right"
                                                Background="{Binding StatusFill}">
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="{Binding StatusColor}" />
                                        </Border>
                                    </Grid>

                                    <!-- last run / last update -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Padding="11" CornerRadius="7" Margin="0,0,6,0"
                                                Background="{StaticResource PanelBrush}"
                                                BorderBrush="{StaticResource BorderBrush2}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="LAST RUN" Style="{StaticResource LabelText}" />
                                                <TextBlock Text="{Binding LastRunText}"
                                                           Style="{StaticResource ValueText}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Padding="11" CornerRadius="7" Margin="6,0,0,0"
                                                Background="{Binding UpdateFill}"
                                                BorderBrush="{Binding UpdateBorder}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="LAST UPDATE" Style="{StaticResource LabelText}" />
                                                    <TextBlock Text=" ●" FontSize="8"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               VerticalAlignment="Center"
                                                               ToolTip="Recorded by the dashboard; no longer in the log file"
                                                               Visibility="{Binding RememberedVisibility}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding LastUpdateText}"
                                                           Style="{StaticResource ValueText}"
                                                           Foreground="{Binding UpdateTextColor}"
                                                           ToolTip="{Binding LastUpdateTooltip}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- error strip -->
                                    <Border Padding="8" CornerRadius="4" Margin="0,0,0,12"
                                            Background="#1AFF4757" BorderBrush="#4DFF4757"
                                            BorderThickness="1"
                                            Visibility="{Binding ErrorVisibility}">
                                        <TextBlock Text="{Binding ErrorMessage}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource DangerBrush}" />
                                    </Border>

                                    <Separator Background="{StaticResource BorderBrush2}" Margin="0,0,0,12" />

                                    <!-- footer buttons -->
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{Binding RunButtonText}"
                                                    Style="{StaticResource SmallPrimary}"
                                                    IsEnabled="{Binding CanRun}"
                                                    ToolTip="{Binding RunTooltip}"
                                                    Tag="{Binding Key}"
                                                    Click="RunOne_Click" Margin="0,0,8,0" />
                                            <Button Content="Clear" Style="{StaticResource SmallDanger}"
                                                    Tag="{Binding Key}"
                                                    ToolTip="Empty this program's log. Its Last Update date is kept."
                                                    Click="ClearOne_Click" />
                                        </StackPanel>
                                        <Button Content="View Log" Style="{StaticResource SmallSecondary}"
                                                HorizontalAlignment="Right"
                                                Tag="{Binding Key}" Click="ViewLog_Click" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- shown when nothing was found on this PC -->
            <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        MaxWidth="520">
                <TextBlock Text="No updaters found on this PC"
                           FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,12" />
                <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           TextAlignment="Center"
                           Text="None of the tracked programs were detected on this PC, and the dashboard's log folder is empty:" />
                <TextBlock x:Name="EmptyPath" FontFamily="{StaticResource MonoFont}"
                           Foreground="{StaticResource AccentBrush}" Margin="0,12"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           TextAlignment="Center"
                           Text="Install one of the tracked programs, or run its updater once, and its card will appear here automatically." />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
